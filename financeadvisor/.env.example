# Example configuration file (.env)

# Authentication token for the brapi.dev API. If you don't have one,
# leave it blank — brapi offers some free demo tickers
# (e.g. AAPL, PETR4, MGLU3, etc.).
BRAPI_TOKEN=

# API key for the Gemini model (Google Generative AI). The
# ``gemini-2.0-flash`` model is used for both insight generation
# and recommendation. Get a key at https://ai.google.dev/.
GEMINI_API_KEY=

# API key for OpenAI models.
OPENAI_API_KEY=

# Redis address used for cache and rate limiting.
REDIS_HOST=localhost
REDIS_PORT=6379

# Optional parameters for the Qdrant vector database. If not set,
# an in-memory instance is used (fine for testing). To use Qdrant
# Cloud, provide the URL and API key.
QDRANT_URL=
QDRANT_API_KEY=
