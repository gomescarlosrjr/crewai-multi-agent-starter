# Copie para .env e preencha. NUNCA versione o .env real.

# LLM — use Gemini (gratuito no AI Studio) OU OpenAI. Basta um.
GEMINI_API_KEY=          # https://aistudio.google.com/app/apikey
OPENAI_API_KEY=          # https://platform.openai.com/api-keys

# API de dados da B3 (opcional; sem token há tickers de demonstração).
BRAPI_TOKEN=             # https://brapi.dev

# Redis (cache) — sobe via docker-compose (veja run_redis.sh).
REDIS_HOST=localhost
REDIS_PORT=6379

# Qdrant (banco vetorial) — opcional. Vazio = instância em memória.
QDRANT_URL=
QDRANT_API_KEY=
