# Copy to .env and fill in. NEVER commit the real .env.

# LLM — use Gemini (free on AI Studio) OR OpenAI. Only one is required.
GEMINI_API_KEY=          # https://aistudio.google.com/app/apikey
OPENAI_API_KEY=          # https://platform.openai.com/api-keys

# B3 market-data API (optional; without a token you get demo tickers).
BRAPI_TOKEN=             # https://brapi.dev

# Redis (cache) — start it via docker-compose (see run_redis.sh).
REDIS_HOST=localhost
REDIS_PORT=6379

# Qdrant (vector database) — optional. Empty = in-memory instance.
QDRANT_URL=
QDRANT_API_KEY=
